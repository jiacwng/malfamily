    "pointer_auth": [
      "paciasp", "pacibsp", "pacia", "pacib", "pacda", "pacdb", "pacga",
      "autiasp", "autibsp", "autia", "autib", "autda", "autdb",
      "xpaci", "xpacd", "retaa", "retab", "braa", "brab", "blraa", "blrab"
