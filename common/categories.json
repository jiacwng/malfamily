    "rol", "ror", "rcl", "rcr", "test", "bt", "bts", "btr",
    "btc", "bsf", "bsr", "shld", "shrd"
  ],
  "data_movement": [
    "mov", "movzx", "movsx", "movsxd", "cmov", "xchg", "bswap",
    "cbw", "cwde", "cdqe", "cwd", "cdq", "cqo", "set"
  ],
  "string_ops": [
    "movs", "cmps", "scas", "lods", "stos", "rep", "repe", "repne", "ins", "outs"
  ],
  "stack_ops": [
    "push", "pop", "pusha", "popa", "pushf", "popf", "pushad", "popad", "enter", "leave"
  ],
  "crypto_extensions": [
    "aesenc", "aesenclast", "aesdec", "aesdeclast", "aesimc", "aeskeygenassist",
    "pclmulqdq", "sha1rnds4", "sha1nexte", "sha1msg1", "sha1msg2",
    "sha256rnds2", "sha256msg1", "sha256msg2", "crc32", "rdrand", "rdseed"
  ],
  "simd": [
    "movaps", "movups", "movdqa", "movdqu", "movd", "movq",
    "padd", "psub", "pmul", "pand", "por", "pxor", "pcmp", "pshuf",
    "punpck", "pack", "pmovmskb", "vmov", "vpxor", "vpadd",
    "addps", "mulps", "subps", "divps", "ptest"
  ],
  "system": [
    "int", "syscall", "sysenter", "sysexit", "sysret", "cpuid",
