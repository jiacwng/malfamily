{
  "_meta": {
    "description": "Mnemonic-root categories for malfamily. A 'root' is an x86/x86-64 instruction stem with size suffixes and condition codes stripped (e.g. jne/je/jz -> 'j', setne/setz -> 'set', paddb/paddw/paddd -> 'padd'). The mapping from a concrete mnemonic to its root is performed in core/extractor.py; this file only declares the canonical root vocabulary grouped by semantic category.",
    "version": 1,
    "arch": ["x86", "x86-64"]
  },
  "control_flow": [
    "j", "jmp", "call", "ret", "loop", "loope", "loopne", "jcxz", "jecxz"
  ],
  "arithmetic": [
    "add", "adc", "sub", "sbb", "mul", "imul", "div", "idiv",
    "inc", "dec", "neg", "cmp", "lea", "xadd"
  ],
  "logical": [
