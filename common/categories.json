{
  "_meta": {
    "description": "Per-architecture mnemonic-root categories for malfamily. A 'root' is an instruction stem with size/sign/condition suffixes stripped (x86: jne/je/jz -> 'j', paddb/w/d -> 'padd'; arm64: b.eq/b.ne -> 'b.cond', ldrb/ldrh/ldrsw -> 'ldr', crc32b/w/x -> 'crc32'). Concrete mnemonic -> root mapping is done in core/extractor.py; this file only declares the canonical root vocabulary per architecture. Models are trained per-architecture because x86 and arm64 share no mnemonics.",
    "version": 2,
    "architectures": ["x86", "arm64"]
  },

  "x86": {
    "control_flow": [
      "j", "jmp", "call", "ret", "loop", "loope", "loopne", "jcxz", "jecxz"
    ],
    "arithmetic": [
      "add", "adc", "sub", "sbb", "mul", "imul", "div", "idiv",
      "inc", "dec", "neg", "cmp", "lea", "xadd"
    ],
    "logical": [
      "and", "or", "xor", "not", "shl", "shr", "sar", "sal",
      "rol", "ror", "rcl", "rcr", "test", "bt", "bts", "btr",
      "btc", "bsf", "bsr", "shld", "shrd"
    ],
    "data_movement": [
      "mov", "movzx", "movsx", "movsxd", "cmov", "xchg", "bswap",
      "cbw", "cwde", "cdqe", "cwd", "cdq", "cqo", "set"
    ],
    "string_ops": [
      "movs", "cmps", "scas", "lods", "stos", "rep", "repe", "repne", "ins", "outs"
    ],
    "stack_ops": [
      "push", "pop", "pusha", "popa", "pushf", "popf", "pushad", "popad", "enter", "leave"
    ],
    "crypto_extensions": [
      "aesenc", "aesenclast", "aesdec", "aesdeclast", "aesimc", "aeskeygenassist",
      "pclmulqdq", "sha1rnds4", "sha1nexte", "sha1msg1", "sha1msg2",
      "sha256rnds2", "sha256msg1", "sha256msg2", "crc32", "rdrand", "rdseed"
    ],
    "simd": [
      "movaps", "movups", "movdqa", "movdqu", "movd", "movq",
      "padd", "psub", "pmul", "pand", "por", "pxor", "pcmp", "pshuf",
      "punpck", "pack", "pmovmskb", "vmov", "vpxor", "vpadd",
      "addps", "mulps", "subps", "divps", "ptest"
    ],
    "system": [
      "int", "syscall", "sysenter", "sysexit", "sysret", "cpuid",
      "rdtsc", "rdtscp", "rdmsr", "wrmsr", "in", "out", "hlt",
      "cli", "sti", "lgdt", "lidt", "ltr", "lldt", "invlpg",
      "wbinvd", "clflush", "lfence", "mfence", "sfence",
      "xgetbv", "xsetbv", "swapgs", "nop", "ud2"
    ],
    "floating_point": [
      "fld", "fst", "fstp", "fadd", "fsub", "fmul", "fdiv", "fcom",
      "fcomp", "fucom", "fild", "fist", "fistp", "fxch", "fabs",
      "fchs", "fsqrt", "fsin", "fcos", "fptan", "fldz", "fld1",
      "fldpi", "fnstsw", "fnstcw", "fldcw", "fwait", "fninit", "fxam", "frndint"
    ]
  },

  "arm64": {
